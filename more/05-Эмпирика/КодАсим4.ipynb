"""
T_n_full_scan_optimized.py

Оптимизированный полный перебор пар n-значных чисел (A, B), A < B,
для перекрёстной разности Δ_n.

Δ_n(A, B) = Σ_{0 ≤ i < j ≤ n−1} (a_i·b_j − a_j·b_i)

Оптимизация: numpy, векторизация, батчи.
Для n = 4: 9000 чисел, 40 495 500 пар, вычисляется за секунды.

Запуск:
    python3 T_n_full_scan_optimized.py        # n = 4 (по умолчанию)
    python3 T_n_full_scan_optimized.py 3      # n = 3 (для проверки)
    python3 T_n_full_scan_optimized.py 2      # n = 2 (мгновенно)
"""

import numpy as np
import sys


def build_digits_and_coeffs(n):
    """Возвращает массив цифр (N, n) и коэффициентов (N, n)."""
    N_MIN = 10 ** (n - 1)
    N_MAX = 10 ** n - 1
    N = N_MAX - N_MIN + 1

    nums = np.arange(N_MIN, N_MAX + 1, dtype=np.int64)
    powers = 10 ** np.arange(n, dtype=np.int64)
    digits = ((nums[:, None] // powers) % 10).astype(np.int32)  # (N, n)

    # sign_matrix[k, j] = +1 если j > k, -1 если j < k, 0 если j == k
    sign_matrix = np.zeros((n, n), dtype=np.int32)
    for k in range(n):
        for j in range(n):
            if j > k:
                sign_matrix[k, j] = 1
            elif j < k:
                sign_matrix[k, j] = -1
    coeffs = (digits @ sign_matrix.T).astype(np.int32)  # (N, n)

    return digits, coeffs, N, N_MIN, N_MAX


def compute_T_n(n, batch_size=1000, verbose=True):
    """
    Вычисляет T_n(K) полным перебором всех пар A < B.
    Возвращает массив T (размер 2·offset+1), offset, N, total_pairs.
    """
    digits, coeffs, N, N_MIN, N_MAX = build_digits_and_coeffs(n)
    total_pairs = N * (N - 1) // 2

    if verbose:
        print(f"n = {n}, чисел: {N:,}  ({N_MIN}..{N_MAX})")
        print(f"Пар с A < B: {total_pairs:,}")
        print(f"Батч: {batch_size}, батчей: {(N + batch_size - 1) // batch_size}")

    offset = 81 * n * (n - 1) // 2
    size = 2 * offset + 1
    T = np.zeros(size, dtype=np.int64)

    j_array = np.arange(N)[None, :]  # (1, N)

    if verbose:
        print("Вычисление...")
    for start in range(0, N, batch_size):
        end = min(start + batch_size, N)
        A_batch = digits[start:end]                  # (b, n)
        Delta_batch = A_batch @ coeffs.T             # (b, N)
        i_array = np.arange(start, end)[:, None]     # (b, 1)
        mask = j_array > i_array                     # (b, N), True где A < B
        values = Delta_batch[mask]
        T += np.bincount(values + offset, minlength=size)

    if verbose:
        print("Готово.")
    return T, offset, N, total_pairs


def analyze(n, verbose=True):
    T, offset, N, total_pairs = compute_T_n(n, verbose=verbose)
    K_values = np.arange(-offset, offset + 1)
    nonzero_mask = T > 0
    nonzero_K = K_values[nonzero_mask]

    print()
    print("=" * 60)
    print(f"РЕЗУЛЬТАТ ДЛЯ n = {n}")
    print("=" * 60)
    print(f"Сумма T(K):           {T.sum():,}  (ожидание: {total_pairs:,})")
    print(f"Совпадение:           {T.sum() == total_pairs}")
    print(f"Диапазон K:           [{nonzero_K.min()}, {nonzero_K.max()}]")
    print(f"Достижимых значений:  {len(nonzero_K)} из {2 * offset + 1}")
    print(f"Теоретическая граница: [{-offset}, {offset}]")
    print(f"Пропущено значений K: {2 * offset + 1 - len(nonzero_K)}")
    print()

    # Гипотеза T(K) ≠ T(-K)
    violations = []
    for k in nonzero_K:
        if k <= 0:
            continue
        t_k = T[k + offset]
        t_minus_k = T[-k + offset]
        if t_k == t_minus_k:
            violations.append(int(k))

    print("=" * 60)
    print("ГИПОТЕЗА: T(K) ≠ T(−K) для всех K ≠ 0 с хотя бы одним положительным")
    print("=" * 60)
    if not violations:
        print(f"ПОДТВЕРЖДЕНА для n = {n}.")
    else:
        print(f"ОПРОВЕРГНУТА для n = {n}.")
        print(f"Контрпримеры: |K| ∈ {violations[:20]}")
    print()

    # Топ-10
    top_idx = np.argsort(T)[::-1]
    print("Топ-10 значений T(K):")
    count = 0
    for idx in top_idx:
        if T[idx] > 0 and count < 10:
            K_val = int(idx - offset)
            print(f"  K = {K_val:5d}:  T = {T[idx]:,}")
            count += 1
    print()

    # Ключевые значения
    print("Ключевые значения:")
    for k in [0, 1, 10, -10, 100, -100, 162, -162]:
        if -offset <= k <= offset:
            t = T[k + offset]
            print(f"  T({k:4d}) = {t:,}")
    print()

    return T, offset, N


if __name__ == "__main__":
    n = 4
    if len(sys.argv) > 1:
        try:
            n = int(sys.argv[1])
        except ValueError:
            n = 4

    # Валидация на n = 2 (быстро, проверка корректности кода)
    if n >= 3:
        print("=" * 60)
        print("ВАЛИДАЦИЯ НА n = 2")
        print("Ожидание: диапазон [-81, 81], 163 значений, сумма 4005,")
        print("T(10) = 60, T(-10) = 46")
        print("=" * 60)
        T2, off2, N2, tp2 = compute_T_n(2, verbose=False)
        nz2 = int((T2 > 0).sum())
        print(f"Диапазон: [{-off2}, {off2}], достижимо: {nz2}, сумма: {T2.sum()}")
        print(f"T(10) = {T2[10 + off2]}, T(-10) = {T2[-10 + off2]}")
        print()

    analyze(n)