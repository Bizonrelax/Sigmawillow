import math

def calculate_bus_pus(number_str):
    """
    Вычисляет ПУС-паспорт (A_p, B_p, C_p) для числовой строки.
    Индексация позиций p идет справа налево (начиная с 1).
    """
    A_p, B_p, C_p = 0, 0, 0
    length = len(number_str)
    
    for i, char in enumerate(number_str):
        if not char.isdigit():
            continue
        x = int(char)
        p = length - i  # Индекс позиции справа налево
        
        if x == 0:
            a, b, c = 0, 0, 0
        else:
            a = x ** 2
            b = 9 * x
            c = b - a
            
        A_p += a * p
        B_p += b * p
        C_p += c * p
        
    return A_p, B_p, C_p

def simulate_lonely_runner_pus(speeds, total_steps=20):
    """
    Моделирует движение бегунов и анализирует их цифровую массу через ПУС.
    """
    num_runners = len(speeds)
    print(f"--- ПУС-анализ задачи о бегунах (Скорости: {speeds}) ---")
    print(f"{'Шаг':<6} | {'Строка позиций':<16} | {'ПУС Вектор (Ap; Bp; Cp)':<25} | {'Перекос Ap/Cp':<12} | {'Закон массы'}")
    print("-" * 85)
    
    for t in range(1, total_steps + 1):
        # Вычисляем дискретную позицию каждого бегуна на треке (от 0 до 9)
        positions = []
        for v in speeds:
            # Непрерывная позиция на круге длиной 1
            pos_continuous = (v * t * 0.05) % 1.0 
            # Дискретизация в одну цифру [0-9]
            digit = int(pos_continuous * 10)
            positions.append(str(digit))
            
        # Формируем числовую строку системы
        system_string = "".join(positions)
        
        # Считаем ПУС-паспорт
        Ap, Bp, Cp = calculate_bus_pus(system_string)
        
        # Коэффициент перекоса (защита от деления на 0)
        ratio = round(Ap / Cp, 2) if Cp != 0 else float('inf')
        
        # Проверка инварианта Пустошилова: Ap + Cp == Bp
        invariant_check = "OK" if (Ap + Cp == Bp) else "ОШИБКА"
        
        print(f"{t:<6} | {system_string:<16} | ({Ap}; {Bp}; {Cp}){"":<4} | {ratio:<12} | {invariant_check}")

# Пример запуска для 4 бегунов с различными скоростями
