package ru.bizonrelax.sigmawillow;

import javax.swing.*;
import java.awt.*;
import java.awt.geom.GeneralPath;
import java.awt.image.BufferedImage;

public class PetalPlotPanel extends JPanel {
    private AppConfig config;

    public PetalPlotPanel(AppConfig config) {
        this.config = config;
        setToolTipText("Экран визуализации лепестков БУС/ПУС");
    }

    public void updateConfig(AppConfig config) {
        this.config = config;
        repaint();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Очистка фона холста графическими параметрами
        g2d.setColor(ConfigManager.hexToColor(config.graphBgColor));
        g2d.fillRect(0, 0, getWidth(), getHeight());

        drawFlowers(g2d, getWidth(), getHeight());
    }

    private void drawFlowers(Graphics2D g2d, int width, int height) {
        String numStr = config.lastNumber.replaceAll("[^0-9]", "");
        if (numStr.isEmpty()) return;

        int centerX = width / 2;
        int centerY = height / 2;
        int totalDigits = numStr.length();

        g2d.setColor(ConfigManager.hexToColor(config.graphColor));
        g2d.setStroke(new BasicStroke(2.0f));

        // Разбор числа справа налево
        for (int i = 0; i < totalDigits; i++) {
            int digit = Character.getNumericValue(numStr.charAt(totalDigits - 1 - i));
            int p = i + 1; // Позиция ПУС

            if (digit == 0) continue; // У нуля нулевой вес

            // Расчет БУС
            double a = digit * digit;
            double b = digit * 9.0;
            double c = b - a;

            // Полярные координаты: угол зависит от позиции p
            double angleRad = Math.toRadians(90.0 - (i * (360.0 / totalDigits)));

            // Масштабирование вылета лепестка под размер экрана
            double scale = Math.min(width, height) / 250.0;
            double length = a * scale;
            double widthParam = c * scale;

            // Отрисовка лепестка в виде петли Безье
            g2d.save();
            g2d.translate(centerX, centerY);
            g2d.rotate(angleRad);

            GeneralPath petal = new GeneralPath();
            petal.moveTo(0, 0);
            // Управляющие точки зависят от параметров a, b, c
            petal.curveTo(-widthParam, length / 3, -widthParam / 2, length, 0, length);
            petal.curveTo(widthParam / 2, length, widthParam, length / 3, 0, 0);
            petal.closePath();

            g2d.draw(petal);
            g2d.restore();
        }
    }

    public BufferedImage exportImage() {
        BufferedImage image = new BufferedImage(getWidth(), getHeight(), BufferedImage.TYPE_INT_RGB);
        Graphics2D g2d = image.createGraphics();
        paintComponent(g2d);
        g2d.dispose();
        return image;
    }
}
