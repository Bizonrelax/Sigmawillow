package ru.bizonrelax.sigmawillow;

import javax.swing.*;
import javax.imageio.ImageIO;
import java.awt.*;
import java.awt.event.*;
import java.io.File;

public class MainWindow extends JFrame {
    private AppConfig config;
    private PetalPlotPanel plotPanel;
    private NotesWindow notesWin = null;

    private JTextField txtNumber;
    private JSpinner spinFontSize, spinWinBg, spinFontColor, spinGraphColor, spinGraphBg;
    private JLabel lblNum;

    public MainWindow() {
        config = ConfigManager.loadConfig();
        
        setTitle("Sigmawillow — Геометрия параметров");
        setSize(config.windowWidth, config.windowHeight);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        plotPanel = new PetalPlotPanel(config);

        // Панель управления элементами интерфейса
        JPanel controlPanel = new JPanel();
        controlPanel.setLayout(new FlowLayout(FlowLayout.LEFT, 10, 10));

        lblNum = new JLabel("Число:");
        txtNumber = new JTextField(config.lastNumber, 10);
        txtNumber.setToolTipText("Введи целое число для расчета лепестков");

        JButton btnPlot = new JButton("Построить");
        btnPlot.setToolTipText("Запустить визуализацию цветка ПУС");
        btnPlot.addActionListener(e -> {
            config.lastNumber = txtNumber.getText();
            plotPanel.updateConfig(config);
        });

        JButton btnExport = new JButton("Экспорт");
        btnExport.setToolTipText("Сохранить холст как PNG изображение");
        btnExport.addActionListener(e -> exportToPng());

        JButton btnFiles = new JButton("Файлы");
        btnFiles.setToolTipText("Открыть проводник в папке с файлами сохранения");
        btnFiles.addActionListener(e -> {
            try {
                Desktop.getDesktop().open(ConfigManager.getSaveDirPath().toFile());
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Не удалось открыть папку.");
            }
        });

        JButton btnNotes = new JButton("Заметки");
        btnNotes.setToolTipText("Открыть независимое окно текстового редактора");
        btnNotes.addActionListener(e -> {
            if (notesWin == null) {
                notesWin = new NotesWindow(this, config);
                notesWin.setVisible(true);
            } else {
                notesWin.toFront();
            }
        });

        JButton btnSave = new JButton("Сохранить изменения");
        btnSave.setToolTipText("Принудительно записать параметры и заметки на диск");
        btnSave.addActionListener(e -> triggerAutoSave());

        // Настройка Спиннеров (используем строки для управления палитрами)
        spinFontSize = new JSpinner(new SpinnerNumberModel(config.fontSize, 10, 40, 1));
        spinFontSize.setToolTipText("Размер текста интерфейса");
        spinFontSize.addChangeListener(e -> {
            config.fontSize = (int) spinFontSize.getValue();
            updateInterfaceStyles();
        });

        spinWinBg = createColorSpinner(config.windowBgColor, "Фон окон");
        spinFontColor = createColorSpinner(config.fontColor, "Цвет шрифтов");
        spinGraphColor = createColorSpinner(config.graphColor, "Цвет лепестков");
        spinGraphBg = createColorSpinner(config.graphBgColor, "Фон холста графика");

        // Компоновка
        controlPanel.add(lblNum);
        controlPanel.add(txtNumber);
        controlPanel.add(btnPlot);
        controlPanel.add(new JLabel("Шрифт:"));
        controlPanel.add(spinFontSize);
        controlPanel.add(new JLabel("Фон:"));
        controlPanel.add(spinWinBg);
        controlPanel.add(new JLabel("Текст:"));
        controlPanel.add(spinFontColor);
        controlPanel.add(new JLabel("График:"));
        controlPanel.add(spinGraphColor);
        controlPanel.add(new JLabel("Фон граф:"));
        controlPanel.add(spinGraphBg);
        
        controlPanel.add(btnNotes);
        controlPanel.add(btnFiles);
        controlPanel.add(btnExport);
        controlPanel.add(btnSave);

        setLayout(new BorderLayout());
        add(controlPanel, BorderLayout.NORTH);
        add(plotPanel, BorderLayout.CENTER);

        updateInterfaceStyles();

        // Логика трекинга изменения размеров окон и закрытия программы
        addComponentListener(new ComponentAdapter() {
            @Override
            public void componentResized(ComponentEvent e) {
                config.windowWidth = getWidth();
                config.windowHeight = getHeight();
            }
        });

        addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                triggerAutoSave();
            }
        });
    }

    private JSpinner createColorSpinner(String defaultHex, String tooltip) {
        String[] colors = {"#FFFFFF", "#F0F0F0", "#E0E0E0", "#000000", "#FF0000", "#00FF00", "#0000FF", "#FF007F", "#FFFF00", "#00FFFF"};
        SpinnerListModel model = new SpinnerListModel(colors);
        JSpinner spinner = new JSpinner(model);
        model.setValue(defaultHex);
        spinner.setToolTipText(tooltip);
        spinner.addChangeListener(e -> {
            String selected = (String) spinner.getValue();
            if(tooltip.contains("Фон окон")) config.windowBgColor = selected;
            if(tooltip.contains("Цвет шрифтов")) config.fontColor = selected;
            if(tooltip.contains("Цвет лепестков")) config.graphColor = selected;
            if(tooltip.contains("Фон холста")) config.graphBgColor = selected;
            updateInterfaceStyles();
        });
        return spinner;
    }

    private void updateInterfaceStyles() {
        Color winBg = ConfigManager.hexToColor(config.windowBgColor);
        Color fColor = ConfigManager.hexToColor(config.fontColor);
        Font f = new Font("Arial", Font.PLAIN, config.fontSize);

        lblNum.setFont(f);
        lblNum.setForeground(fColor);
        txtNumber.setFont(f);

        getContentPane().setBackground(winBg);
        plotPanel.updateConfig(config);
        if (notesWin != null) {
            notesWin.applyConfigStyles();
        }
    }

    public void closeAllSubWindows() {
        if (notesWin != null) {
            notesWin.saveCurrentText();
            notesWin.dispose();
            notesWin = null;
        }
        setVisible(true);
        toFront();
    }

    public void notifyNotesClosed() {
        notesWin = null;
    }

    private void exportToPng() {
        try {
            File outputfile = new File(ConfigManager.getSaveDirPath().toFile(), "petal_graph.png");
            ImageIO.write(plotPanel.exportImage(), "png", outputfile);
            JOptionPane.showMessageDialog(this, "График сохранен в файл:\n" + outputfile.getAbsolutePath());
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Ошибка экспорта: " + ex.getMessage());
        }
    }

    private void triggerAutoSave() {
        config.lastNumber = txtNumber.getText();
        if (notesWin != null) {
            notesWin.saveCurrentText();
        }
        ConfigManager.saveConfig(config);
    }
}
