package ru.bizonrelax.sigmawillow;

import java.io.*;
import java.nio.file.*;
import java.util.Properties;
import java.awt.Color;

public class ConfigManager {
    private static final String DIR_NAME = "Sigmawillow";
    private static final String FILE_NAME = "config.properties";
    private static Path saveDir;

    static {
        String userHome = System.getProperty("user.home");
        saveDir = Paths.get(userHome, "Documents", DIR_NAME);
    }

    public static Path getSaveDirPath() {
        return saveDir;
    }

    public static AppConfig loadConfig() {
        AppConfig config = new AppConfig();
        Path filePath = saveDir.resolve(FILE_NAME);
        if (!Files.exists(filePath)) {
            return config;
        }

        try (InputStream is = Files.newInputStream(filePath)) {
            Properties prop = new Properties();
            prop.load(is);
            
            config.lastNumber = prop.getProperty("lastNumber", config.lastNumber);
            config.fontSize = Integer.parseInt(prop.getProperty("fontSize", String.valueOf(config.fontSize)));
            config.windowWidth = Integer.parseInt(prop.getProperty("windowWidth", String.valueOf(config.windowWidth)));
            config.windowHeight = Integer.parseInt(prop.getProperty("windowHeight", String.valueOf(config.windowHeight)));
            config.windowBgColor = prop.getProperty("windowBgColor", config.windowBgColor);
            config.fontColor = prop.getProperty("fontColor", config.fontColor);
            config.graphColor = prop.getProperty("graphColor", config.graphColor);
            config.graphBgColor = prop.getProperty("graphBgColor", config.graphBgColor);
            config.notesText = prop.getProperty("notesText", config.notesText).replace("\\n", "\n");
        } catch (Exception e) {
            System.err.println("Ошибка загрузки конфигурации: " + e.getMessage());
        }
        return config;
    }

    public static void saveConfig(AppConfig config) {
        try {
            if (!Files.exists(saveDir)) {
                Files.createDirectories(saveDir);
            }
            Path filePath = saveDir.resolve(FILE_NAME);
            Properties prop = new Properties();
            
            prop.setProperty("lastNumber", config.lastNumber);
            prop.setProperty("fontSize", String.valueOf(config.fontSize));
            prop.setProperty("windowWidth", String.valueOf(config.windowWidth));
            prop.setProperty("windowHeight", String.valueOf(config.windowHeight));
            prop.setProperty("windowBgColor", config.windowBgColor);
            prop.setProperty("fontColor", config.fontColor);
            prop.setProperty("graphColor", config.graphColor);
            prop.setProperty("graphBgColor", config.graphBgColor);
            prop.setProperty("notesText", config.notesText.replace("\n", "\\n"));

            try (OutputStream os = Files.newOutputStream(filePath)) {
                prop.store(os, "Sigmawillow Application Saved Parameters");
            }
        } catch (Exception e) {
            System.err.println("Ошибка сохранения конфигурации: " + e.getMessage());
        }
    }

    public static String colorToHex(Color color) {
        return String.format("#%02X%02X%02X", color.getRed(), color.getGreen(), color.getBlue());
    }

    public static Color hexToColor(String hex) {
        return Color.decode(hex);
    }
}
